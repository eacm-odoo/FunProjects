# Copy to .env and fill in. The keys stay on the server: the browser never sees them.

# --- Claude ---------------------------------------------------------------
# claude | fake (canned answers, no key, no cost: handy to work on the UI)
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max. Lower effort = faster first sentence.
CLAUDE_EFFORT=low
# adaptive | off. "off" is the fastest, but only Claude Sonnet 5.5 accepts it
# (and only with CLAUDE_EFFORT low, medium or high).
CLAUDE_THINKING=adaptive
# on | off. If Claude declines a question, retry it on another model in the same stream.
CLAUDE_FALLBACKS=on

# --- Speech ---------------------------------------------------------------
# To try the app with the Claude key only: STT_PROVIDER=fake and TTS_PROVIDER=none.
# One Deepgram account can do both ears and voice: STT_PROVIDER=deepgram and
# TTS_PROVIDER=deepgram, and its free credit pays for both.

# deepgram | fake (no key: always "hears" one of three sample questions)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# A recording stops on its own after this many seconds.
MAX_RECORDING_SECONDS=20

# elevenlabs | deepgram (uses DEEPGRAM_API_KEY) | fake (no key: a hum with the
# rhythm of speech) | none (text only, no voice)
TTS_PROVIDER=elevenlabs

# Deepgram Aura-2 Spanish voices, by accent:
#   Mexican:        aura-2-estrella-es (mature), aura-2-olivia-es, aura-2-javier-es,
#                   aura-2-luciano-es, aura-2-sirio-es, aura-2-valerio-es
#   Latin American: aura-2-selena-es, aura-2-aquila-es
#   Colombian:      aura-2-celeste-es, aura-2-gloria-es
#   Argentine:      aura-2-antonia-es
#   Spain:          aura-2-nestor-es, aura-2-carina-es, aura-2-alvaro-es, aura-2-diana-es,
#                   aura-2-agustina-es, aura-2-silvia-es
DEEPGRAM_VOICE=aura-2-estrella-es

ELEVENLABS_API_KEY=
# On the free plan only ElevenLabs' default voices work through the API; Voice
# Library voices answer "paid_plan_required" until you upgrade. With a paid plan:
# Voices > Voice Library, filter by Spanish, add the voice to "My Voices", then
# copy its ID from the voice menu.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Cost limits ----------------------------------------------------------
# Questions per hour for the whole server (0 = no limit).
MAX_QUESTIONS_PER_HOUR=30
# max_tokens of each answer (thinking included). Five sentences and their
# diagram take about 500.
MAX_TOKENS_PER_ANSWER=1000
# Earlier questions and answers sent back for follow-ups (0 = none).
HISTORY_TURNS=4

# --- Server ---------------------------------------------------------------
PORT=8787
# Keep 127.0.0.1: the Quest reaches it through `adb reverse`, and nothing else
# on the network should be able to spend your keys.
HOST=127.0.0.1
# Pages allowed to open the WebSocket (comma separated). Defaults to
# http://localhost:PORT and http://127.0.0.1:PORT.
# ALLOWED_ORIGINS=
# Language of the transcription and of the voice: es, or a regional code such
# as es-419. Not called LANGUAGE because Linux shells already set that one for
# the system locale, and the shell's value would win over this file.
TEACHER_LANGUAGE=es
