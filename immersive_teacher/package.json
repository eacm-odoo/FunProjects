{
  "name": "immersive-teacher",
  "version": "0.1.0",
  "private": true,
  "description": "Mixed reality teacher for Meta Quest 3: ask out loud, hear the answer and watch a 3D diagram build up next to the teacher.",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "node --watch-path=server/src server/src/index.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/src/index.js --prod",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "three": "^0.187.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@iwer/devui": "2.7.0",
    "@iwer/sem": "2.7.0",
    "iwer": "2.7.0",
    "vite": "^8.3.6"
  }
}
