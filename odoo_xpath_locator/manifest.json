{
    "manifest_version": 3,
    "name": "Odoo XPath Locator",
    "version": "1.0.0",
    "description": "Finds the node an inherited view's xpath points to in the parent view's architecture and highlights its line.",
    "minimum_chrome_version": "120",
    "permissions": ["activeTab", "scripting"],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "Locate an xpath in this architecture",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png"
        }
    }
}
