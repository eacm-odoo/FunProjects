<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="pingpong_3d.Game">
        <div class="o_pp_stage" t-ref="stage"/>

        <div class="o_pp_ui">
            <t t-if="state.screen === 'playing'">
                <div class="o_pp_hud">
                    <div class="side you">
                        <div class="lbl">You</div>
                        <div class="val" t-out="state.score[localSide]"/>
                    </div>
                    <div class="mid">
                        <div class="diff">
                            <t t-if="state.mode === 'online'">
                                <t t-out="state.room ? state.room.code : 'Online'"/>
                            </t>
                            <t t-else="" t-out="difficultyName"/>
                        </div>
                        <div class="serve">Serving: <t t-out="serverName"/></div>
                    </div>
                    <div class="side cpu">
                        <div class="lbl" t-out="opponentLabel"/>
                        <div class="val" t-out="state.score[remoteSide]"/>
                    </div>
                </div>

                <div class="o_pp_meters">
                    <div class="o_pp_meter">
                        <div class="t"><span>Power</span><b t-ref="powVal">0.0 m/s</b></div>
                        <div class="o_pp_bar"><i t-ref="powBar"/></div>
                    </div>
                    <div class="o_pp_meter">
                        <div class="t"><span>Spin</span><b t-ref="spinVal">—</b></div>
                        <div class="o_pp_bar spin"><i t-ref="spinBar"/></div>
                    </div>
                </div>

                <div class="o_pp_hint">
                    <b>Move the mouse</b> to place the paddle: horizontal aims, vertical raises or lowers.<br/>
                    <b>Hit with movement</b>: sweeping up gives topspin, down backspin, and sideways side spin.<br/>
                    <kbd>Space</kbd> serve ·
                    <t t-if="state.mode === 'solo'"><kbd>P</kbd> pause · </t>
                    <kbd>C</kbd> camera
                </div>

                <div class="o_pp_net" t-if="state.mode === 'online'"
                     t-att-title="'Total to opponent: ' + state.rtt + ' ms · round trip to myself: '
                                  + state.selfRtt + ' ms · HTTP only: ' + state.httpRtt
                                  + ' ms · in flight: ' + state.inFlight
                                  + ' · dropped as stale: ' + state.superseded
                                  + ' · worst frame: ' + state.worstFrame + ' ms'
                                  + ' · link: ' + (state.peerLink === 'open' ? 'direct (p2p)' : 'Odoo bus')">
                    <span t-att-class="'dot ' + (state.rtt &lt; 120 ? 'good' : (state.rtt &lt; 250 ? 'fair' : 'poor'))"/>
                    <t t-out="state.rtt"/> ms
                    <b class="o_pp_link" t-if="state.peerLink === 'open'"
                       title="Direct browser-to-browser connection">p2p</b>
                    <b class="o_pp_link off" t-elif="state.peerLink === 'failed' or state.peerLink === 'unavailable'"
                       title="Could not open a direct connection; the match goes through the server">bus</b>
                    <small t-if="state.httpRtt">
                        http <t t-out="state.httpRtt"/><t t-if="state.selfRtt"> · me <t t-out="state.selfRtt"/></t><t t-if="state.fps"> · <t t-out="state.fps"/> fps</t>
                    </small>
                </div>
            </t>

            <div class="o_pp_toast" t-att-style="state.toast ? 'opacity:1' : 'opacity:0'">
                <t t-if="state.toast">
                    <t t-out="state.toast.main"/>
                    <small t-if="state.toast.sub" t-out="state.toast.sub"/>
                </t>
            </div>

            <!-- menu -->
            <div class="o_pp_screen" t-if="state.screen === 'menu'">
                <div class="o_pp_card">
                    <div class="o_pp_brand"><span class="dot"/>Ping Pong 3D</div>
                    <h1>Play against the machine<br/>or against someone else</h1>
                    <p>Real physics: gravity, air drag and the Magnus effect. Topspin dips the ball,
                        backspin slows it and side spin curves it. First to <t t-out="matchPoint"/> points wins.</p>

                    <div class="o_pp_diffs">
                        <button t-foreach="difficulties" t-as="diff" t-key="diff.key"
                                t-att-class="diff.key === state.difficulty ? 'on' : ''"
                                t-on-click="() => this.setDifficulty(diff.key)">
                            <strong t-out="diff.name"/>
                            <span t-out="diff.blurb"/>
                        </button>
                    </div>
                    <div class="o_pp_row">
                        <button class="o_pp_btn primary" t-on-click="startSolo">Play against the machine</button>
                        <button class="o_pp_btn ghost" t-on-click="cycleCamera">
                            Camera: <t t-out="state.camLabel"/>
                        </button>
                    </div>

                    <div class="o_pp_sep"><span>or play online 1 on 1</span></div>

                    <div class="o_pp_online">
                        <input type="text" class="o_pp_input" placeholder="Your name"
                               maxlength="24" t-model="state.nickname"/>
                        <div class="o_pp_row">
                            <button class="o_pp_btn primary" t-on-click="createRoom"
                                    t-att-disabled="state.busy">Create room</button>
                            <span class="o_pp_or">or</span>
                            <input type="text" class="o_pp_input code" placeholder="PONG-XXXX"
                                   maxlength="12" t-model="state.joinCode"/>
                            <button class="o_pp_btn ghost" t-on-click="joinRoom"
                                    t-att-disabled="state.busy">Join</button>
                        </div>
                        <p class="o_pp_error" t-if="state.error" t-out="state.error"/>
                    </div>
                </div>
            </div>

            <!-- lobby -->
            <div class="o_pp_screen" t-if="state.screen === 'lobby' and state.room">
                <div class="o_pp_card">
                    <div class="o_pp_brand"><span class="dot"/>Room</div>
                    <h1 class="o_pp_code" t-on-click="copyCode" title="Copy"
                        t-out="state.room.code"/>
                    <p>Share the code with the other person. Once they are in, the host starts the match.</p>

                    <div class="o_pp_players">
                        <div t-foreach="state.room.players" t-as="player" t-key="player.slot"
                             t-att-class="'o_pp_player' + (player.slot === state.room.slot ? ' me' : '')">
                            <span class="tag" t-out="player.role === 'host' ? 'Host' : 'Guest'"/>
                            <span class="who" t-out="player.name"/>
                            <span class="you" t-if="player.slot === state.room.slot">you</span>
                        </div>
                        <div class="o_pp_player waiting" t-if="state.room.players.length &lt; 2">
                            <span class="tag">Guest</span>
                            <span class="who">Waiting…</span>
                        </div>
                    </div>

                    <p class="o_pp_error" t-if="state.error" t-out="state.error"/>
                    <p class="o_pp_error" t-if="state.opponentGone" t-out="state.opponentGone"/>

                    <!-- The bus with nothing on it. Compare against the figure
                         shown during play: if this one is small and that one is
                         not, the traffic is the problem, not the server. -->
                    <p class="o_pp_probe" t-if="state.idleRtt">
                        Idle bus: <b><t t-out="state.idleRtt"/> ms</b>
                        <span> (HTTP <t t-out="state.idleHttp"/> ms)</span>
                    </p>

                    <div class="o_pp_row" style="margin-top:22px">
                        <button class="o_pp_btn primary" t-if="isHost"
                                t-att-disabled="!canStart or state.busy"
                                t-on-click="startOnlineMatch">Start match</button>
                        <span class="o_pp_or" t-if="!isHost">Waiting for the host…</span>
                        <button class="o_pp_btn ghost" t-on-click="leaveRoom">Leave room</button>
                    </div>
                </div>
            </div>

            <!-- pause, solo only -->
            <div class="o_pp_screen" t-if="state.paused">
                <div class="o_pp_card">
                    <div class="o_pp_brand"><span class="dot"/>Paused</div>
                    <h1><t t-out="state.score[localSide]"/> — <t t-out="state.score[remoteSide]"/></h1>
                    <p>The match is on hold. You can resume or go back to the menu to change the difficulty.</p>
                    <div class="o_pp_row" style="margin-top:24px">
                        <button class="o_pp_btn primary" t-on-click="() => this.setPaused(false)">Resume</button>
                        <button class="o_pp_btn ghost" t-on-click="toMenu">Back to menu</button>
                    </div>
                </div>
            </div>

            <!-- opponent walked away -->
            <div class="o_pp_screen" t-if="state.opponentGone and state.screen === 'playing'">
                <div class="o_pp_card">
                    <div class="o_pp_brand"><span class="dot"/>Match interrupted</div>
                    <h1>You are on your own</h1>
                    <p t-out="state.opponentGone"/>
                    <div class="o_pp_row" style="margin-top:24px">
                        <button class="o_pp_btn primary" t-on-click="toMenu">Back to menu</button>
                    </div>
                </div>
            </div>

            <!-- end of match -->
            <div class="o_pp_screen" t-if="state.screen === 'over' and state.result">
                <div class="o_pp_card">
                    <div class="o_pp_brand">
                        <span class="dot"/><t t-out="state.result.won ? 'Victory' : 'Defeat'"/>
                    </div>
                    <h1 t-out="state.result.won ? 'You won the match!' : opponentName + ' wins'"/>
                    <div class="o_pp_final">
                        <b><t t-out="state.result.mine"/> — <t t-out="state.result.theirs"/></b>
                        <span>
                            <t t-if="state.mode === 'solo'"><t t-out="difficultyName"/> difficulty · </t>
                            <t t-out="state.result.hits"/> hits ·
                            <t t-out="state.result.rallies"/> rallies
                        </span>
                    </div>
                    <div class="o_pp_row" style="margin-top:26px">
                        <button class="o_pp_btn primary" t-if="state.mode === 'solo'"
                                t-on-click="startSolo">Rematch</button>
                        <button class="o_pp_btn ghost" t-on-click="toMenu">Back to menu</button>
                    </div>
                </div>
            </div>
        </div>

        <a href="/" class="o_pp_back">← Back</a>
    </t>

</templates>
