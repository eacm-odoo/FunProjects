<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pingpong_match_view_list" model="ir.ui.view">
        <field name="name">pingpong.match.list</field>
        <field name="model">pingpong.match</field>
        <field name="arch" type="xml">
            <list string="Matches" decoration-success="won == True" decoration-muted="won == False">
                <field name="create_date" string="Date"/>
                <field name="mode" optional="show"/>
                <field name="player_name"/>
                <field name="opponent_name" optional="show"/>
                <field name="partner_id" optional="hide"/>
                <field name="difficulty" optional="show"/>
                <field name="player_score" sum="Player Score"/>
                <field name="machine_score" sum="Machine Score"/>
                <field name="margin"/>
                <field name="hits" optional="show"/>
                <field name="rallies" optional="hide"/>
                <field name="won" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="pingpong_match_view_form" model="ir.ui.view">
        <field name="name">pingpong.match.form</field>
        <field name="model">pingpong.match</field>
        <field name="arch" type="xml">
            <form string="Match">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="mode" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="player_nickname" invisible="mode != 'online'"/>
                            <field name="difficulty"
                                   invisible="mode != 'solo'"
                                   required="mode == 'solo'"/>
                            <field name="create_date" string="Played On" readonly="1"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                        <group>
                            <field name="opponent_partner_id" invisible="mode != 'online'"/>
                            <field name="opponent_nickname" invisible="mode != 'online'"/>
                            <field name="player_score"/>
                            <field name="machine_score"/>
                            <field name="margin"/>
                            <field name="winner_side"/>
                            <field name="hits"/>
                            <field name="rallies"/>
                            <field name="session_id" invisible="mode != 'online'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pingpong_match_view_graph" model="ir.ui.view">
        <field name="name">pingpong.match.graph</field>
        <field name="model">pingpong.match</field>
        <field name="arch" type="xml">
            <graph string="Matches" type="bar">
                <field name="difficulty"/>
                <field name="margin" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="pingpong_match_view_search" model="ir.ui.view">
        <field name="name">pingpong.match.search</field>
        <field name="model">pingpong.match</field>
        <field name="arch" type="xml">
            <search string="Matches">
                <field name="player_name"/>
                <field name="opponent_name"/>
                <field name="partner_id"/>
                <field name="difficulty"/>
                <filter name="filter_solo" string="Against the Machine" domain="[('mode','=','solo')]"/>
                <filter name="filter_online" string="Online 1v1" domain="[('mode','=','online')]"/>
                <separator/>
                <filter name="filter_won" string="Wins" domain="[('won','=',True)]"/>
                <filter name="filter_lost" string="Losses" domain="[('won','=',False)]"/>
                <separator/>
                <filter name="filter_registered" string="Registered Players" domain="[('partner_id','!=',False)]"/>
                <group>
                    <filter name="group_mode" string="Mode" context="{'group_by': 'mode'}"/>
                    <filter name="group_difficulty" string="Difficulty" context="{'group_by': 'difficulty'}"/>
                    <filter name="group_partner" string="Player" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="pingpong_match_action" model="ir.actions.act_window">
        <field name="name">Matches</field>
        <field name="res_model">pingpong.match</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No matches yet</p>
            <p>Open /pingpong and play one: the result will show up here.</p>
        </field>
    </record>

    <record id="pingpong_play_action" model="ir.actions.act_url">
        <field name="name">Play</field>
        <field name="url">/pingpong</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_pingpong_root" name="Ping Pong 3D" sequence="95"/>
    <menuitem id="menu_pingpong_play" name="Jugar" parent="menu_pingpong_root" action="pingpong_play_action" sequence="10"/>
    <menuitem id="menu_pingpong_matches" name="Partidos" parent="menu_pingpong_root" action="pingpong_match_action" sequence="20"/>
</odoo>
