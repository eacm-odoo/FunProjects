<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Full-screen game page.

        It used to be a standalone HTML document with an importmap pointing at
        unpkg. It now goes through web.frontend_layout so the page gets the Odoo
        module registry, rpc and bus_service, while three.js is served from
        static/lib. no_header/no_footer strip the portal navbar that would
        otherwise sit on top of the canvas.

        The game assets live in their own bundle rather than in
        web.assets_frontend: three.js is a couple of megabytes of source and has
        no business being downloaded on every page of the website. That bundle
        is fetched at runtime by static/src/boot/pingpong_boot.js, which is the
        module's only entry in web.assets_frontend. A `t-call-assets` here would
        run before Odoo's module loader exists.

        The whole interface is an OWL app mounted on .o_pingpong_root, so the
        only thing this template carries is the anchor and its configuration.
    -->
    <template id="game_page" name="Ping Pong 3D">
        <t t-call="web.frontend_layout">
            <t t-set="title">Ping Pong 3D</t>
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="body_classname" t-value="'o_pingpong_page'"/>
            <t t-set="head">
                <meta name="author" content="Odoo"/>
                <meta name="generator" content="Odoo"/>
            </t>

            <div class="o_pingpong_root" t-att-data-score-url="score_url"/>
        </t>
    </template>
</odoo>
