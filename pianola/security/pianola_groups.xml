<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="res_groups_privilege_pianola" model="res.groups.privilege">
            <field name="name">Pianola</field>
            <field name="sequence">40</field>
            <field name="category_id" ref="base.module_category_productivity"/>
        </record>

        <record id="group_pianola_user" model="res.groups">
            <field name="name">User: read and play scores</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_pianola"/>
            <field name="comment">Can browse the library and play a score, but cannot
                import one or change what was compiled.</field>
        </record>

        <record id="group_pianola_manager" model="res.groups">
            <field name="name">Manager: import and correct scores</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_pianola"/>
            <field name="implied_ids" eval="[(4, ref('group_pianola_user'))]"/>
            <field name="comment">Can import scores, recompile them and fix notes by
                hand -- which is what the optical recognition phase needs.</field>
        </record>

        <!-- The library is public within the database: every internal user can
             open a score and play it. Importing and correcting stays with the
             managers. -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('pianola.group_pianola_user'))]"/>
        </record>

        <record id="base.user_admin" model="res.users">
            <field name="group_ids" eval="[(4, ref('pianola.group_pianola_manager'))]"/>
        </record>

    </data>
</odoo>
