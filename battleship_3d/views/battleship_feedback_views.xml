<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="battleship_feedback_view_list" model="ir.ui.view">
        <field name="name">battleship.feedback.list</field>
        <field name="model">battleship.feedback</field>
        <field name="arch" type="xml">
            <list string="Feedback">
                <field name="create_date"/>
                <field name="kind"/>
                <field name="name"/>
                <field name="user_id" optional="show"/>
                <field name="game_id" optional="show"/>
                <field name="game_mode" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="battleship_feedback_view_form" model="ir.ui.view">
        <field name="name">battleship.feedback.form</field>
        <field name="model">battleship.feedback</field>
        <field name="arch" type="xml">
            <form string="Feedback">
                <header>
                    <field name="state" widget="statusbar"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Subject"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="create_date"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="game_id"/>
                            <field name="game_mode"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What happened, or what you would like to see."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="battleship_feedback_view_search" model="ir.ui.view">
        <field name="name">battleship.feedback.search</field>
        <field name="model">battleship.feedback</field>
        <field name="arch" type="xml">
            <search string="Feedback">
                <field name="name"/>
                <field name="description"/>
                <filter name="bugs" string="Bugs" domain="[('kind', '=', 'bug')]"/>
                <filter name="ideas" string="Ideas" domain="[('kind', '=', 'idea')]"/>
                <separator/>
                <filter name="open" string="Not handled" domain="[('state', '!=', 'done')]"/>
                <separator/>
                <filter name="reported" string="Reported" date="create_date"/>
                <group>
                    <filter name="by_kind" string="Kind" domain="[]"
                            context="{'group_by': 'kind'}"/>
                    <filter name="by_state" string="State" domain="[]"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="battleship_feedback_action" model="ir.actions.act_window">
        <field name="name">Feedback</field>
        <field name="res_model">battleship.feedback</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="battleship_feedback_view_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing reported yet</p>
            <p>Bugs and ideas sent from the "Report" button on the board land here.</p>
        </field>
    </record>
</odoo>
