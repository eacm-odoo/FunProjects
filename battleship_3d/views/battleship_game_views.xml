<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="battleship_game_view_list" model="ir.ui.view">
        <field name="name">battleship.game.list</field>
        <field name="model">battleship.game</field>
        <field name="arch" type="xml">
            <!-- The counters live in the footer of this list: how many games
                 the filter matched, and the hours they took. Grouping by mode,
                 player or month splits both without a report of its own. -->
            <list string="Games">
                <field name="name"/>
                <field name="user_id"/>
                <field name="mode"/>
                <field name="code" optional="show"/>
                <field name="state"/>
                <field name="winner"/>
                <field name="shot_count" sum="Shots"/>
                <field name="create_date"/>
                <field name="date_end" optional="hide"/>
                <field name="duration" widget="float_time" sum="Time played"/>
            </list>
        </field>
    </record>

    <record id="battleship_game_view_form" model="ir.ui.view">
        <field name="name">battleship.game.form</field>
        <field name="model">battleship.game</field>
        <field name="arch" type="xml">
            <form string="Game">
                <header>
                    <button name="action_open_board" type="object" string="Open board"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="mode"/>
                        </group>
                        <group>
                            <field name="current_player"/>
                            <field name="winner"/>
                            <field name="end_reason" invisible="not winner"/>
                            <field name="shot_count"/>
                            <field name="date_end" invisible="state != 'done'"/>
                            <field name="duration" widget="float_time"
                                   invisible="state != 'done'"/>
                        </group>
                        <group string="Online room" invisible="mode != 'online'">
                            <field name="code"/>
                            <field name="name_a"/>
                            <field name="name_b"/>
                            <field name="ready_a"/>
                            <field name="ready_b"/>
                            <field name="rematch_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Shot log">
                            <field name="shot_ids" readonly="1">
                                <list>
                                    <field name="shooter"/>
                                    <field name="coord"/>
                                    <field name="result"/>
                                    <field name="ship_name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="battleship_game_view_search" model="ir.ui.view">
        <field name="name">battleship.game.search</field>
        <field name="model">battleship.game</field>
        <field name="arch" type="xml">
            <search string="Games">
                <field name="name"/>
                <field name="user_id"/>
                <field name="code"/>
                <filter name="finished" string="Finished" domain="[('state', '=', 'done')]"/>
                <filter name="running" string="Still running"
                        domain="[('state', '!=', 'done')]"/>
                <separator/>
                <filter name="online" string="Online" domain="[('mode', '=', 'online')]"/>
                <filter name="vs_cpu" string="vs CPU" domain="[('mode', '=', 'cpu')]"/>
                <separator/>
                <!-- `date` builds the period filters (month, quarter, year and
                     the one before each) without a domain of its own. -->
                <filter name="started" string="Started" date="create_date"/>
                <group>
                    <filter name="by_mode" string="Mode" domain="[]"
                            context="{'group_by': 'mode'}"/>
                    <filter name="by_state" string="State" domain="[]"
                            context="{'group_by': 'state'}"/>
                    <filter name="by_player" string="Player" domain="[]"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="by_month" string="Start month" domain="[]"
                            context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="battleship_game_action" model="ir.actions.act_window">
        <field name="name">Games</field>
        <field name="res_model">battleship.game</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="battleship_game_view_search"/>
    </record>

    <record id="battleship_board_action" model="ir.actions.client">
        <field name="name">Battleship</field>
        <field name="tag">battleship_3d.board</field>
    </record>
</odoo>
