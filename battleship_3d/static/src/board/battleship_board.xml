<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!-- Glossary, report, sound, and the way out of whatever is on screen. Lives in
     the right-hand fleet plate when there are two, and on a strip of its own
     when there are four; the buttons are the same either way. -->
<t t-name="battleship_3d.BoardTools">
    <button t-on-click="openCodex">Glossary</button>
    <button t-on-click="() => this.openReport('bug')">Report</button>
    <button t-attf-class="{{ ui.soundOn ? 'on' : '' }}" t-on-click="toggleSound"
            t-esc="soundLabel"/>
    <button t-attf-class="{{ ui.patrolOn ? 'on' : '' }}" t-on-click="togglePatrol"
            t-esc="patrolLabel"/>
    <button class="danger o_bs_spacer" t-if="room" t-on-click="leaveRoom">Leave room</button>
    <button class="primary o_bs_spacer" t-else="" t-on-click="() => this.newGame()">New game</button>
</t>

<!-- The name this browser plays under, and the way to change it. A player who
     came in through an invitation link was never asked for one, and one who was
     asked can mistype it, so it is a field rather than a fact. Shown twice: in
     the waiting room, where a name is what everybody is looking at, and on the
     bridge, because a free-for-all writes it on the water for the whole game. -->
<t t-name="battleship_3d.RenameField">
    <div class="o_bs_rename" t-if="canRename">
        <t t-if="ui.renaming">
            <input type="text" placeholder="YOUR NAME" maxlength="32" autofocus="autofocus"
                   t-model="ui.rename" t-on-keydown="onRenameKey"/>
            <button class="primary" t-att-disabled="ui.busy" t-on-click="saveRename">Save</button>
            <button t-on-click="cancelRename">Cancel</button>
        </t>
        <button t-else="" class="o_bs_rename_open" t-on-click="startRename">
            <span class="o_bs_rename_name" t-esc="myName"/>
            <span class="o_bs_rename_hint">rename</span>
        </button>
    </div>
</t>

<t t-name="battleship_3d.Board">
    <div class="o_battleship" t-if="game">

        <!-- The bridge: who is playing, what the board is waiting for, the
             tally, and the last three lines off the radio. -->
        <div class="o_bs_bar o_bs_bar_top">
            <div class="o_bs_panel o_bs_brand">
                <div class="o_bs_wordmark">
                    <h1>Battleship</h1>
                    <span class="o_bs_hull">HMS · 1943</span>
                </div>
                <div class="o_bs_seg">
                    <button t-attf-class="{{ game.mode === 'cpu' ? 'active' : '' }}"
                            t-on-click="() => this.newGame('cpu')">vs CPU</button>
                    <button t-attf-class="{{ game.mode === 'hotseat' ? 'active' : '' }}"
                            t-on-click="() => this.newGame('hotseat')">2 players</button>
                    <button t-attf-class="{{ game.mode === 'online' ? 'active' : '' }}"
                            t-on-click="() => this.newGame('online')">Online</button>
                    <button t-attf-class="{{ game.mode === 'royale' ? 'active' : '' }}"
                            t-on-click="() => this.newGame('royale')">4-way battle</button>
                </div>
                <span class="o_bs_code" t-if="room" t-esc="game.code"/>
                <t t-call="battleship_3d.RenameField"/>
            </div>

            <div class="o_bs_panel o_bs_orders">
                <span class="o_bs_orders_tag">Orders</span>
                <span t-attf-class="o_bs_status {{ room and aiming ? 'hot' : '' }}"
                      t-esc="statusText"/>
                <span class="o_bs_salvo" t-if="game.state === 'battle'" t-esc="salvoLabel"/>
            </div>

            <!-- Everything here counts finished games, and only those: the one
                 on screen joins the tally when it is over. -->
            <div class="o_bs_panel o_bs_record">
                <div class="o_bs_sect">Record</div>
                <div class="o_bs_score">
                    <div class="won"><b t-esc="game.record.wins"/>Won</div>
                    <div class="lost"><b t-esc="game.record.losses"/>Lost</div>
                </div>
            </div>

            <div class="o_bs_log">
                <div class="o_bs_log_head">
                    <span>Radio log</span>
                    <span t-esc="clock"/>
                </div>
                <div class="o_bs_log_rows">
                    <div class="o_bs_log_empty" t-if="!game.log.length">Nothing on the air yet.</div>
                    <t t-foreach="game.log.slice(0, 3)" t-as="entry" t-key="entry_index">
                        <div class="o_bs_log_row">
                            <span class="o_bs_log_from"><t t-esc="sideLabel(entry.shooter)"/> →</span>
                            <span class="o_bs_log_cell">
                                <t t-if="seats.length > 2"><t t-esc="entry.target.toUpperCase()"/>:</t><t t-esc="entry.coord"/>
                            </span>
                            <span t-attf-class="o_bs_log_res {{ entry.result }}"
                                  t-esc="logResult(entry)"/>
                        </div>
                    </t>
                </div>
            </div>
        </div>

        <div t-attf-class="o_bs_canvas {{ aiming ? 'o_bs_aim' : '' }}" t-ref="canvas">
            <!-- The game, wound back and played forward. It takes the same
                 slot as the two banners under it and never fights them for it:
                 a replay frame says the game is over, which is the one thing
                 both of them refuse to talk over. It is also the only thing on
                 this screen that moves on its own, hence the controls. -->
            <div t-if="ui.replay" class="o_bs_replay">
                <button class="primary" t-on-click="toggleReplay" t-esc="replayPlayLabel"/>
                <button t-on-click="restartReplay">From the top</button>
                <button class="o_bs_replay_speed" t-on-click="cycleReplaySpeed"
                        t-esc="replaySpeedLabel"/>
                <span class="o_bs_replay_count" t-esc="replayCounter"/>
                <input class="o_bs_replay_track" type="range" min="0" step="1"
                       t-att-max="replayTape.length" t-att-value="ui.replay.index"
                       t-on-input="onReplaySeek"/>
                <span class="o_bs_replay_line" t-esc="replayLine"/>
                <button t-on-click="closeReplay">Close (Esc)</button>
            </div>
            <!-- Whose move it is, over the water, where the player is already
                 looking. The board itself carries the other half of the answer:
                 a plate that breathes on the grid the next shot belongs to. -->
            <!-- Nothing has been heard from the other seat in a while. It takes
                 the turn banner's place because it is the more urgent half of
                 the same question: the board is waiting, and this says why. -->
            <div t-if="awayNotice" class="o_bs_turnbar o_bs_quiet">
                <span class="o_bs_turnbar_dot"/>
                <b>No signal</b>
                <span class="o_bs_turnbar_sub" t-esc="awayNotice"/>
            </div>
            <div t-elif="turnBanner"
                 t-attf-class="o_bs_turnbar {{ turnBanner.mine ? 'mine' : 'theirs' }}">
                <span class="o_bs_turnbar_dot"/>
                <b t-esc="turnBanner.title"/>
                <span class="o_bs_turnbar_sub" t-esc="turnBanner.text"/>
            </div>
            <!-- The dispatch was pushed aside to look at the board. Both fleets
                 are on the water by then — the server stops hiding them once a
                 game is over — so this is the one moment the whole thing can
                 actually be looked at. -->
            <div class="o_bs_inspect" t-if="ui.inspect">
                <span class="o_bs_inspect_text" t-esc="statusText"/>
                <button t-on-click="closeInspect">Back to the dispatch (Esc)</button>
            </div>
            <div class="o_bs_hint">Drag to orbit · scroll to zoom · R rotates the ship · 1-5 picks one</div>
        </div>

        <!-- One plate per grid, in the same order as the two boards on screen:
             side A on the left, side B on the right, whichever of them is ours.
             Ours reads as a fleet with names; the other one as radar contacts,
             which is exactly what the server sends. -->
        <div t-attf-class="o_bs_bar o_bs_bar_bottom {{ seats.length > 2 ? 'o_bs_many' : '' }}">
            <t t-foreach="seats" t-as="seat" t-key="seat.side">
                <t t-set="side" t-value="seat.side"/>
                <div t-attf-class="o_bs_panel {{ panelClass(side) }} {{ isMine(side) ? '' : 'o_bs_enemy' }} {{ seat.out ? 'o_bs_out' : '' }}">
                    <div class="o_bs_fleet_head">
                        <span class="o_bs_fleet_title" t-esc="panelTitle(side)"/>
                        <span class="o_bs_tagline" t-if="seat.cpu">CPU</span>
                        <span class="o_bs_tagline o_bs_gone" t-if="seat.out">Out</span>
                        <span t-attf-class="o_bs_turn {{ myTurn ? '' : 'muted' }}"
                              t-if="game.state === 'battle' and game.current_player === side and !seat.out"
                              t-esc="turnTag(side)"/>
                        <!-- A turn owes a shell to every board still afloat, so
                             the ones it has not been to yet say so, and the one
                             a hit just bought another shell at says it louder.
                             A board already dealt with wears nothing at all. -->
                        <span t-attf-class="o_bs_turn o_bs_owed {{ side === repeatTarget ? 'o_bs_again' : '' }}"
                              t-if="myTurn and pendingTargets.includes(side)"
                              t-esc="owedTag(side)"/>
                        <span class="o_bs_turn"
                              t-if="room and game.state === 'setup' and game.ready[side]">Fleet locked</span>
                        <span class="o_bs_afloat" t-esc="afloatLabel(side)"/>
                    </div>

                    <div class="o_bs_fleet">
                        <t t-foreach="fleetOf(side)" t-as="ship" t-key="ship_index">
                            <div t-attf-class="o_bs_ship {{ shipClass(side, ship, ship_index) }}"
                                 t-att-role="canPlace(side) ? 'button' : null"
                                 t-on-click="() => this.selectShip(side, ship_index)">
                                <span class="o_bs_ship_name" t-esc="ship.name"/>
                                <span class="o_bs_pips">
                                    <t t-foreach="Array(ship.size).fill(0)" t-as="pip" t-key="pip_index">
                                        <span t-attf-class="o_bs_pip {{ pip_index &lt; ship.hits ? 'on' : '' }}"/>
                                    </t>
                                </span>
                            </div>
                        </t>
                    </div>

                    <div class="o_bs_btns o_bs_actions" t-if="canPlace(side)">
                        <button t-on-click="rotate">Rotate (R)</button>
                        <button t-on-click="randomFleet">Random</button>
                        <button class="primary o_bs_spacer" t-on-click="ready" t-esc="readyLabel"/>
                    </div>
                    <!-- Two plates have room for the toolbar inside the right
                         one, which is where the design puts it. Four do not, so
                         it takes a strip of its own under them. -->
                    <div class="o_bs_btns o_bs_actions" t-if="seat_last and seats.length &lt;= 2">
                        <t t-call="battleship_3d.BoardTools"/>
                    </div>
                </div>
            </t>
            <div class="o_bs_panel o_bs_toolbar o_bs_btns" t-if="seats.length &gt; 2">
                <t t-call="battleship_3d.BoardTools"/>
            </div>
        </div>

        <!-- The way in: the screen the board opens on, and the one the final
             dispatch sends the player back to. It sits over a game that already
             exists, so picking a mode is either a door or a new record — never
             a wait. -->
        <div class="o_bs_over o_bs_start" t-if="ui.menu === 'start'">
            <div class="o_bs_grain"/>
            <div class="o_bs_vignette"/>

            <div class="o_bs_start_grid">
                <div class="o_bs_start_left">
                    <div>
                        <div class="o_bs_eyebrow">Operation · North Sea</div>
                        <h2 class="o_bs_title">Battle<br/>ship</h2>
                        <p class="o_bs_lede">Sink the enemy fleet before they sink yours.
                            Coordinates by radio, fire by salvo.</p>
                    </div>

                    <div class="o_bs_start_btns">
                        <button class="o_bs_main_btn" t-on-click="() => this.startGame('cpu')">
                            <span class="o_bs_main_no">01</span>
                            <span class="o_bs_main_text">
                                <span class="o_bs_main_title">vs CPU</span>
                                <span class="o_bs_main_sub">Against the automatic admiralty</span>
                            </span>
                            <span class="o_bs_main_arrow">▸▸</span>
                        </button>

                        <div class="o_bs_start_pair">
                            <button class="o_bs_tile" t-on-click="() => this.startGame('hotseat')">
                                <span class="o_bs_tile_title">2 players</span>
                                <span class="o_bs_tile_sub">Same command post</span>
                            </button>
                            <button class="o_bs_tile" t-on-click="() => this.openOnline('online')">
                                <span class="o_bs_tile_title">Online<span class="o_bs_dot"/></span>
                                <span class="o_bs_tile_sub">Room by radio code</span>
                            </button>
                        </div>

                        <!-- Four boards, one winner. It is a room like the duel
                             is, so it goes through the same panel — the empty
                             seats are what makes one player enough. -->
                        <button class="o_bs_tile o_bs_wide" t-on-click="() => this.openOnline('royale')">
                            <span class="o_bs_tile_title">4-way battle<span class="o_bs_dot brass"/></span>
                            <span class="o_bs_tile_sub">Everybody shoots everybody. Up to four
                                admirals, and the admiralty takes the empty chairs</span>
                        </button>

                        <!-- Who the admiralty is whenever it holds a seat: the
                             opponent in a game against the CPU, and every
                             chair nobody claimed in a free-for-all. A game
                             carries the level it was opened at and keeps it to
                             the end, so this is about the next one. -->
                        <div class="o_bs_levels">
                            <span class="o_bs_eyebrow">Enemy admiralty</span>
                            <div class="o_bs_seg">
                                <button t-foreach="difficulties" t-as="level" t-key="level.key"
                                        t-attf-class="{{ level.key === ui.difficulty ? 'active' : '' }}"
                                        t-on-click="() => this.setDifficulty(level.key)"
                                        t-esc="level.name"/>
                            </div>
                            <p class="o_bs_level_blurb" t-esc="chosenLevel.blurb"/>
                        </div>

                        <div class="o_bs_btns">
                            <button t-on-click="openCodex">Fleet glossary</button>
                            <button t-attf-class="{{ ui.soundOn ? 'on' : '' }}" t-on-click="toggleSound"
                                    t-esc="soundLabel"/>
                            <button t-attf-class="{{ ui.patrolOn ? 'on' : '' }}" t-on-click="togglePatrol"
                                    t-esc="patrolLabel"/>
                            <button class="o_bs_link" t-if="game.state !== 'setup'"
                                    t-on-click="closeStart">Back to the board</button>
                        </div>
                    </div>
                </div>

                <div class="o_bs_start_right">
                    <div class="o_bs_dossier">
                        <div class="o_bs_dossier_head">
                            <span class="o_bs_eyebrow">Commander's file</span>
                            <b>Service record</b>
                        </div>
                        <div class="o_bs_stats">
                            <div class="o_bs_stat won">
                                <b t-esc="game.record.wins"/><span>Wins</span>
                            </div>
                            <div class="o_bs_stat lost">
                                <b t-esc="game.record.losses"/><span>Losses</span>
                            </div>
                            <div class="o_bs_stat games">
                                <b t-esc="game.record.games"/><span>Games</span>
                            </div>
                            <div class="o_bs_stat">
                                <b t-esc="timePlayed"/><span>On deck</span>
                            </div>
                        </div>
                        <div class="o_bs_dossier_note" t-esc="dispatchLine"/>
                        <div class="o_bs_stamp"><span>Classified</span></div>
                    </div>

                    <div class="o_bs_hintbox">Drag to orbit · wheel to zoom · R rotates · 1-5 picks</div>
                </div>
            </div>
        </div>

        <!-- Opening or joining a room. Nothing here touches the game that is
             already on screen: it is only replaced once the server answers. -->
        <div class="o_bs_over" t-if="ui.menu === 'online'">
            <div class="o_bs_grain"/>
            <div class="o_bs_card">
                <div class="o_bs_card_head">
                    <span class="o_bs_eyebrow">Encrypted channel</span>
                    <h2 t-esc="openingRoyale ? '4-way battle' : 'Play online'"/>
                </div>
                <p t-if="openingRoyale">Four fleets on one table, everybody shooting at
                    everybody, and the last one afloat takes it. Open a room and pass the link
                    around, or type the code you were given. Empty chairs are played by the
                    admiralty, so you can sail with one.</p>
                <p t-else="">Open a room and send your opponent the link, or type the code you
                    were given.</p>
                <input type="text" placeholder="YOUR NAME" maxlength="32" t-model="ui.nickname"/>
                <button class="primary" t-att-disabled="ui.busy" t-on-click="createRoom"
                        t-esc="openingRoyale ? 'Open a table' : 'Open a room'"/>
                <div class="o_bs_or">or</div>
                <div class="o_bs_join">
                    <input type="text" placeholder="BSHP-XXXX" maxlength="12" t-model="ui.joinCode"/>
                    <button t-att-disabled="ui.busy" t-on-click="joinRoom">Join</button>
                </div>
                <p class="o_bs_err" t-if="ui.error" t-esc="ui.error"/>
                <button class="o_bs_link" t-on-click="closeMenu" t-esc="backLabel"/>
            </div>
        </div>

        <!-- Waiting room. The link is the whole invitation: whoever opens it
             takes the free seat, so it is what the buttons here are about and
             the code is only kept for reading it out loud. -->
        <div class="o_bs_over" t-if="room and game.state === 'lobby' and !ui.menu">
            <div class="o_bs_grain"/>
            <div class="o_bs_card">
                <div class="o_bs_card_head">
                    <span class="o_bs_eyebrow">Room open · waiting</span>
                    <h2 t-esc="game.code"/>
                </div>
                <p t-if="royale">Send this link to up to three others. Whoever is not there
                    when you sail is played by the admiralty — one of you is enough.</p>
                <p t-else="">Send this link to your opponent. They join by opening it — no account,
                    no code to type.</p>

                <!-- Who is at the table so far. A free-for-all is the only room
                     where that is a question with more than one answer. -->
                <div class="o_bs_muster" t-if="royale">
                    <t t-foreach="seats" t-as="seat" t-key="seat.side">
                        <div t-attf-class="o_bs_berth {{ seat.taken ? 'in' : '' }}">
                            <span class="o_bs_berth_seat" t-esc="seat.side.toUpperCase()"/>
                            <span class="o_bs_berth_name"
                                  t-esc="seat.taken ? seat.name : 'Empty — the admiralty takes it'"/>
                            <span class="o_bs_berth_you" t-if="seat.side === game.you">you</span>
                        </div>
                    </t>
                </div>

                <t t-call="battleship_3d.RenameField"/>

                <input class="o_bs_invite" type="text" readonly="readonly" t-ref="invite"
                       t-att-value="game.invite_url" t-on-focus="(ev) => ev.target.select()"/>
                <button class="primary" t-if="canStartRoom" t-att-disabled="ui.busy"
                        t-on-click="startRoom">Sail now</button>
                <p class="o_bs_wait" t-if="royale and !canStartRoom">
                    Waiting for <t t-esc="sideLabel('a')"/> to sail.
                </p>
                <button t-attf-class="{{ canStartRoom ? '' : 'primary' }}"
                        t-on-click="shareInvite" t-esc="shareLabel"/>
                <button t-on-click="copyCode">Copy the code instead</button>
                <p class="o_bs_err" t-if="ui.error" t-esc="ui.error"/>
                <button class="o_bs_link" t-on-click="leaveRoom">Close the room</button>
            </div>
        </div>

        <!-- Fleet glossary: the real models, on the same sea, one at a time.
             The turntable is built by a useEffect keyed on this canvas, so it
             exists exactly while the panel is open. -->
        <div class="o_bs_over o_bs_over_top" t-if="ui.codex">
            <div class="o_bs_panel o_bs_codex">
                <div class="o_bs_codex_head">
                    <div class="o_bs_sect">Fleet glossary</div>
                    <button class="o_bs_link" t-on-click="closeCodex">Close (Esc)</button>
                </div>

                <div class="o_bs_codex_body">
                    <div class="o_bs_codex_list">
                        <t t-foreach="glossary" t-as="entry" t-key="entry.name">
                            <button t-attf-class="o_bs_codex_item {{ entry.name === ui.codex ? 'sel' : '' }}"
                                    t-on-click="() => this.showShip(entry.name)">
                                <span t-esc="entry.name"/>
                                <span class="o_bs_pips">
                                    <t t-foreach="Array(entry.size).fill(0)" t-as="pip" t-key="pip_index">
                                        <span class="o_bs_pip"/>
                                    </t>
                                </span>
                            </button>
                        </t>
                    </div>

                    <div class="o_bs_codex_view">
                        <div class="o_bs_codex_canvas" t-ref="glossaryCanvas"/>
                        <div class="o_bs_codex_info">
                            <h3 t-esc="codexEntry.name"/>
                            <div class="o_bs_codex_sub" t-esc="codexEntry.sub"/>
                            <p t-esc="codexEntry.desc"/>
                        </div>
                    </div>
                </div>

                <div class="o_bs_codex_note" t-esc="glossaryNote"/>
            </div>
        </div>

        <!-- Bugs and ideas, from wherever the board is being played: they land
             on `battleship.feedback` in the backend, under the Battleship menu.
             The game on screen travels with the report, so a bug about a board
             arrives with the board. -->
        <div class="o_bs_over" t-if="ui.report">
            <div class="o_bs_grain"/>
            <div class="o_bs_card">
                <div class="o_bs_card_head">
                    <span class="o_bs_eyebrow">Signals · to the admiralty</span>
                    <h2>Report</h2>
                </div>
                <p>Something broken, or something you would rather play instead.</p>
                <div class="o_bs_seg">
                    <button t-attf-class="{{ ui.report.kind === 'bug' ? 'active' : '' }}"
                            t-on-click="() => this.setReportKind('bug')">Bug</button>
                    <button t-attf-class="{{ ui.report.kind === 'idea' ? 'active' : '' }}"
                            t-on-click="() => this.setReportKind('idea')">Idea</button>
                </div>
                <input class="o_bs_prose" type="text" placeholder="One line about it" maxlength="80"
                       t-model="ui.report.subject"/>
                <textarea rows="5" maxlength="2000"
                          placeholder="What happened, and what you were doing at the time."
                          t-model="ui.report.body"/>
                <p class="o_bs_err" t-if="ui.error" t-esc="ui.error"/>
                <button class="primary" t-att-disabled="ui.busy" t-on-click="sendReport">
                    Send it
                </button>
                <button class="o_bs_link" t-on-click="closeReport">Back to the board (Esc)</button>
            </div>
        </div>

        <div class="o_bs_over" t-if="ui.pass">
            <div class="o_bs_grain"/>
            <div class="o_bs_card">
                <div class="o_bs_card_head">
                    <span class="o_bs_eyebrow">Change of watch</span>
                    <h2 t-esc="ui.pass.title"/>
                </div>
                <p t-esc="ui.pass.text"/>
                <button class="primary" t-on-click="continuePass">I'm ready</button>
            </div>
        </div>

        <!-- The final dispatch. `settling` holds it back while the last shells
             are still falling: the card covers the board, and that salvo is the
             point. -->
        <div class="o_bs_over"
             t-if="game.state === 'done' and !ui.menu and !ui.settling and !ui.inspect and !ui.replay">
            <div class="o_bs_grain"/>
            <div class="o_bs_vignette"/>
            <div class="o_bs_dispatch_card">
                <div class="o_bs_eyebrow" t-esc="'Final dispatch · ' + clock"/>
                <h2 t-esc="statusText"/>
                <p t-if="game.end_reason === 'forfeit'">The room is closed.</p>
                <p t-else="" t-esc="endReport"/>
                <!-- Which admiralty was on the other side of it. Only worth
                     saying where there was one, and only where the fleet was
                     actually fought to the bottom. -->
                <p class="o_bs_dispatch_note"
                   t-if="hasCpu and game.end_reason !== 'forfeit'" t-esc="levelNote"/>
                <div class="o_bs_btns">
                    <t t-if="room">
                        <button class="primary" t-if="game.end_reason !== 'forfeit'" t-on-click="rematch">
                            Again
                        </button>
                        <button class="o_bs_ghost" t-on-click="leaveRoom">Leave the room</button>
                    </t>
                    <t t-else="">
                        <button class="primary" t-on-click="() => this.newGame()">Again</button>
                        <button class="o_bs_ghost" t-on-click="openStart">Menu</button>
                    </t>
                </div>
                <!-- Both fleets are on the water now. Worth a look — either
                     as it ended, or shell by shell from the first salvo. -->
                <button class="o_bs_ghost o_bs_wreckage" t-on-click="inspectBoard">
                    See the wreckage
                </button>
                <button class="o_bs_ghost o_bs_wreckage" t-if="canReplay"
                        t-att-disabled="ui.busy" t-on-click="openReplay">
                    Replay the battle
                </button>
                <div t-attf-class="o_bs_stamp {{ endStamp.lost ? 'lost' : '' }}">
                    <span t-esc="endStamp.text"/>
                </div>
            </div>
        </div>
    </div>
</t>

</templates>
