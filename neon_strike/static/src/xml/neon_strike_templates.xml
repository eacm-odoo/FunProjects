<templates xml:space="preserve">

<t t-name="neon_strike.Game">
    <div class="o_neon_strike d-flex flex-column h-100">
        <div class="ns_toolbar d-flex align-items-center px-3 py-2">
            <span class="ns_logo me-3">NEON STRIKE</span>
            <t t-if="state.screen === 'game'">
                <button class="btn btn-sm ns_btn me-2" t-on-click="toggleMute">
                    <i t-attf-class="fa {{ state.muted ? 'fa-volume-off' : 'fa-volume-up' }} me-1" role="img" aria-label="Sonido"/>Sonido
                </button>
                <button class="btn btn-sm ns_btn me-2" t-if="state.role !== 'guest'" t-on-click="restart">
                    <i class="fa fa-refresh me-1" role="img" aria-label="Reiniciar"/>Reiniciar
                </button>
                <button class="btn btn-sm ns_btn" t-on-click="backToMenu">
                    <i class="fa fa-sign-out me-1" role="img" aria-label="Menú"/>Menú
                </button>
                <span class="ns_room ms-3" t-if="state.match">
                    Sala <b t-out="state.match.code"/>
                </span>
            </t>
            <span class="ms-auto">
                <a href="https://www.odoo.com/page/brand-assets" target="_blank" rel="noreferrer" class="ns_brand_link">built on Odoo</a>
            </span>
        </div>

        <!-- ============================ MENÚ ============================ -->
        <div t-if="state.screen === 'menu'" class="ns_menu flex-grow-1 d-flex">
            <div class="ns_menu_card m-auto p-4">
                <h2 class="ns_title mb-1">NEON STRIKE</h2>
                <p class="ns_sub mb-4">Shooter espacial cooperativo · hasta 4 jugadores · sin registro</p>
                <div class="ns_nick mb-3">
                    <label class="ns_nick_label" for="ns_nick_input">Tu apodo</label>
                    <input id="ns_nick_input" type="text" class="form-control ns_input_nick"
                           placeholder="¿Cómo te llamas?" maxlength="20" t-model="state.nickname"/>
                </div>
                <div class="d-grid gap-2 mb-3">
                    <button class="btn ns_cta" t-on-click="startSolo" t-att-disabled="state.connecting">
                        <i class="fa fa-play me-2" role="img" aria-label="Jugar"/>Jugar solo
                    </button>
                    <button class="btn ns_cta ns_cta_alt" t-on-click="createMatch" t-att-disabled="state.connecting">
                        <i class="fa fa-users me-2" role="img" aria-label="Crear"/>Crear partida
                    </button>
                </div>
                <div class="ns_join input-group mb-2">
                    <input type="text" class="form-control ns_input_code" placeholder="Código de sala (p. ej. NEON-4F2)"
                           t-model="state.joinCode" t-on-keydown="onCodeKeydown"/>
                    <button class="btn ns_btn" t-on-click="joinMatch" t-att-disabled="state.connecting">Unirse</button>
                </div>
                <p t-if="state.error" class="ns_error mb-0" t-out="state.error"/>
                <hr class="ns_hr"/>
                <t t-call="neon_strike.Leaderboard"/>
            </div>
        </div>

        <!-- ============================ LOBBY =========================== -->
        <div t-elif="state.screen === 'lobby'" class="ns_menu flex-grow-1 d-flex">
            <div class="ns_menu_card m-auto p-4" t-if="state.match">
                <h2 class="ns_title mb-1">Sala de espera</h2>
                <p class="ns_sub mb-3">Comparte el código para que se unan tus amigos.</p>
                <div class="ns_code_box mb-4">
                    <span class="ns_code_label">Código</span>
                    <span class="ns_code" t-out="state.match.code"/>
                </div>
                <h6 class="ns_players_head">
                    Jugadores (<t t-out="state.match.participants.length"/>/<t t-out="state.match.max_players"/>)
                </h6>
                <ul class="ns_players list-unstyled mb-4">
                    <li t-foreach="state.match.participants" t-as="p" t-key="p.slot" class="d-flex align-items-center mb-2">
                        <span class="ns_dot me-2" t-attf-style="background-color: {{ p.color }}"/>
                        <span t-out="p.name"/>
                        <span class="ns_you ms-2" t-if="p.slot === state.match.slot">(tú)</span>
                        <span class="ns_host_tag ms-auto" t-if="p.slot === state.match.host_slot">anfitrión</span>
                    </li>
                </ul>
                <div class="d-grid gap-2">
                    <button class="btn ns_cta" t-if="isHost" t-on-click="startMatch">
                        <i class="fa fa-rocket me-2" role="img" aria-label="Empezar"/>Empezar
                    </button>
                    <p t-else="" class="ns_waiting mb-0">Esperando a que el anfitrión empiece…</p>
                    <button class="btn ns_btn" t-on-click="leaveMatch">Salir</button>
                </div>
                <p t-if="state.error" class="ns_error mt-2 mb-0" t-out="state.error"/>
            </div>
        </div>

        <!-- ============================ JUEGO =========================== -->
        <div t-else="" class="ns_body d-flex flex-grow-1">
            <div class="ns_stage flex-grow-1">
                <canvas t-ref="canvas"/>
            </div>
            <aside class="ns_leaderboard p-3">
                <t t-call="neon_strike.Leaderboard"/>
                <p class="ns_hint mb-0">Arrastra para mover la nave. Cápsulas: T triple · S escudo · B bomba · + vida. Vuela junto a un aliado caído para revivirlo.</p>
            </aside>
        </div>
    </div>
</t>

<t t-name="neon_strike.Leaderboard">
    <h5 class="mb-3">
        <i class="fa fa-trophy me-2" role="img" aria-label="Trofeo"/>Marcadores
    </h5>
    <table class="table table-sm ns_table">
        <thead>
            <tr>
                <th>#</th>
                <th>Jugador</th>
                <th class="text-end">Puntos</th>
                <th class="text-end">Oleada</th>
            </tr>
        </thead>
        <tbody>
            <t t-foreach="state.scores" t-as="s" t-key="s.id">
                <tr>
                    <td t-out="s_index + 1"/>
                    <td>
                        <span t-out="s.player_name"/>
                        <span class="ns_coop_tag ms-1" t-if="s.mode === 'coop'" t-attf-title="Cooperativo · {{ s.player_count }} jugadores">co-op x<t t-out="s.player_count"/></span>
                    </td>
                    <td class="text-end" t-out="fmt(s.score)"/>
                    <td class="text-end" t-out="s.wave"/>
                </tr>
            </t>
            <tr t-if="!state.scores.length">
                <td colspan="4" class="text-muted">Sin puntuaciones aún. ¡Sé el primero!</td>
            </tr>
        </tbody>
    </table>
</t>

</templates>
