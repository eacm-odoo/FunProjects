<templates xml:space="preserve">

<t t-name="neon_strike.Game">
    <div class="o_neon_strike d-flex flex-column h-100">
        <!-- The toolbar band belongs to the screens that are not the game.
             During play it collapses into the Esc pip the HUD draws on canvas,
             and everything it used to hold moves into the pause overlay: the
             band was 36 px tall across the whole window, which is more of the
             field than the entire HUD occludes. -->
        <div t-if="state.screen !== 'game'" class="ns_toolbar d-flex align-items-center px-3 py-2">
            <span class="ns_logo me-3">NEON STRIKE</span>
            <span class="ms-auto">
                <a href="https://www.odoo.com/page/brand-assets" target="_blank" rel="noreferrer" class="ns_brand_link">built on Odoo</a>
            </span>
        </div>

        <!-- ============================ MENU ============================ -->
        <div t-if="state.screen === 'menu'" class="ns_menu flex-grow-1 d-flex">
            <canvas t-ref="menuCanvas" class="ns_menu_bg" aria-hidden="true"/>
            <div class="ns_menu_card m-auto p-4">
                <h2 class="ns_title mb-1">NEON STRIKE</h2>
                <p class="ns_sub mb-4" t-if="multiplayer">Co-op space shooter · up to 4 players · no sign-up</p>
                <p class="ns_sub mb-4" t-else="">Arcade space shooter · 50 perks · no sign-up</p>
                <div class="ns_nick mb-3">
                    <label class="ns_nick_label" for="ns_nick_input">Your nickname</label>
                    <input id="ns_nick_input" type="text" class="form-control ns_input_nick"
                           placeholder="What should we call you?" maxlength="20" t-model="state.nickname"/>
                </div>
                <div class="ns_hulls mb-3">
                    <span class="ns_nick_label">Your ship</span>
                    <div class="ns_hull_row">
                        <button t-foreach="shipCards" t-as="s" t-key="s.id"
                                type="button"
                                t-attf-class="ns_hull {{ state.ship === s.id ? 'ns_hull_on' : '' }}"
                                t-att-aria-pressed="state.ship === s.id ? 'true' : 'false'"
                                t-attf-style="--ns-hull: {{ s.tint }}"
                                t-att-title="s.desc"
                                t-on-click="() => this.pickShip(s.id)">
                            <img t-att-src="s.src" t-att-alt="s.label"/>
                            <span class="ns_hull_name" t-out="s.label"/>
                            <span class="ns_hull_sub" t-out="s.sub"/>
                        </button>
                    </div>
                    <p class="ns_hull_hint mb-0">They all fly the same: pick the one you like.</p>
                </div>
                <div class="d-grid gap-2 mb-3">
                    <button class="btn ns_cta" t-on-click="startSolo" t-att-disabled="state.connecting">
                        <i class="fa fa-play me-2" role="img" aria-label="Play"/>
                        <t t-out="multiplayer ? 'Play solo' : 'Play'"/>
                    </button>
                    <button t-if="multiplayer" class="btn ns_cta ns_cta_alt" t-on-click="createMatch" t-att-disabled="state.connecting">
                        <i class="fa fa-users me-2" role="img" aria-label="Create"/>Create match
                    </button>
                </div>
                <div t-if="multiplayer" class="ns_join input-group mb-2">
                    <input type="text" class="form-control ns_input_code" placeholder="Room code (e.g. NEON-4F2)"
                           t-model="state.joinCode" t-on-keydown="onCodeKeydown"/>
                    <button class="btn ns_btn" t-on-click="joinMatch" t-att-disabled="state.connecting">Join</button>
                </div>
                <p t-if="state.error" class="ns_error mb-0" t-out="state.error"/>
                <button class="btn ns_btn ns_glossary_open w-100 mt-2" t-on-click="toggleGlossary">
                    <i class="fa fa-book me-2" role="img" aria-label="Glossary"/>Ships, enemies and powers
                </button>
                <button class="btn ns_btn w-100 mt-2" t-on-click="openFeedback">
                    <i class="fa fa-comment me-2" role="img" aria-label="Feedback"/>Report a bug or an idea
                </button>
                <hr class="ns_hr"/>
                <t t-call="neon_strike.Leaderboard"/>
            </div>
        </div>

        <!-- ============================ LOBBY =========================== -->
        <div t-elif="state.screen === 'lobby'" class="ns_menu flex-grow-1 d-flex">
            <div class="ns_menu_card m-auto p-4" t-if="multiplayer and state.match">
                <h2 class="ns_title mb-1">Waiting room</h2>
                <p class="ns_sub mb-3">Share the code so your friends can join.</p>
                <div class="ns_code_box mb-4">
                    <span class="ns_code_label">Code</span>
                    <span class="ns_code" t-out="state.match.code"/>
                </div>
                <h6 class="ns_players_head">
                    Players (<t t-out="state.match.participants.length"/>/<t t-out="state.match.max_players"/>)
                </h6>
                <ul class="ns_players list-unstyled mb-4">
                    <li t-foreach="state.match.participants" t-as="p" t-key="p.slot" class="d-flex align-items-center mb-2">
                        <span class="ns_dot me-2" t-attf-style="background-color: {{ p.color }}"/>
                        <span t-out="p.name"/>
                        <span class="ns_you ms-2" t-if="p.slot === state.match.slot">(you)</span>
                        <span class="ns_host_tag ms-auto" t-if="p.slot === state.match.host_slot">host</span>
                    </li>
                </ul>
                <div class="d-grid gap-2">
                    <button class="btn ns_cta" t-if="isHost" t-on-click="startMatch">
                        <i class="fa fa-rocket me-2" role="img" aria-label="Start"/>Start
                    </button>
                    <p t-else="" class="ns_waiting mb-0">Waiting for the host to start…</p>
                    <button class="btn ns_btn" t-on-click="leaveMatch">Leave</button>
                </div>
                <p t-if="state.error" class="ns_error mt-2 mb-0" t-out="state.error"/>
            </div>
        </div>

        <!-- ============================ GAME =========================== -->
        <!-- The play screen is the arena and a rail. The 300 px side panel is
             gone: its leaderboard lives in the pause overlay, where somebody is
             actually reading it, and its hint block with it. -->
        <div t-else="" class="ns_body ns_body_play d-flex flex-column flex-grow-1">
            <div class="ns_stage flex-grow-1">
                <canvas t-ref="canvas"/>
            </div>
            <!-- Attribution during play: below the arena, so it never covers
                 the field and it never scrolls away. -->
            <div class="ns_rail d-flex align-items-center px-3">
                <span class="ns_rail_tag" t-if="multiplayer and state.match">
                    Room <b t-out="state.match.code"/>
                </span>
                <span class="ns_rail_tag ns_practice_tag" t-if="state.practice">
                    Practice <b t-out="state.practiceLabel"/>
                </span>
                <a href="https://www.odoo.com/page/brand-assets" target="_blank" rel="noreferrer"
                   class="ns_brand_link ms-auto">built on Odoo</a>
            </div>
        </div>
        <t t-if="state.screen === 'game' and state.paused">
            <t t-call="neon_strike.Pause"/>
        </t>
        <!-- The glossary layers over any screen now, because the pause overlay
             opens it too. It used to be rendered inside the menu branch only. -->
        <t t-if="state.glossary">
            <t t-call="neon_strike.Glossary"/>
        </t>
        <t t-if="state.feedback">
            <t t-call="neon_strike.Feedback"/>
        </t>
    </div>
</t>

<!-- Esc overlay: everything the toolbar band used to hold, plus the two
     things the HUD stopped drawing over the field (the leaderboard and the
     perks you own). It owns the pause: the canvas draws no PAUSED text now. -->
<t t-name="neon_strike.Pause">
    <div class="ns_glossary ns_pause" role="dialog" aria-label="Paused" t-on-click="onPauseBackdrop">
        <div class="ns_glossary_panel ns_pause_panel">
            <div class="ns_glossary_head d-flex align-items-center">
                <span class="ns_pause_pip me-2"/>
                <h4 class="ns_glossary_title mb-0">PAUSED</h4>
                <span class="ns_pause_hint ms-auto">Esc to resume</span>
            </div>
            <div class="ns_pause_actions d-flex flex-wrap gap-2 px-3 py-3">
                <button class="btn btn-sm ns_btn" t-on-click="togglePause">
                    <i class="fa fa-play me-1" role="img" aria-label="Resume"/>Resume
                </button>
                <button class="btn btn-sm ns_btn" t-on-click="toggleMute">
                    <i t-attf-class="fa {{ state.muted ? 'fa-volume-off' : 'fa-volume-up' }} me-1" role="img" aria-label="Sound"/>
                    <t t-out="state.muted ? 'Sound off' : 'Sound on'"/>
                </button>
                <button class="btn btn-sm ns_btn" t-if="state.role !== 'guest'" t-on-click="restart">
                    <i class="fa fa-refresh me-1" role="img" aria-label="Restart"/>Restart
                </button>
                <button class="btn btn-sm ns_btn" t-on-click="backToMenu">
                    <i class="fa fa-sign-out me-1" role="img" aria-label="Menu"/>Menu
                </button>
                <button class="btn btn-sm ns_btn" t-on-click="openFeedback">
                    <i class="fa fa-bug me-1" role="img" aria-label="Feedback"/>Feedback
                </button>
                <button class="btn btn-sm ns_btn" t-on-click="toggleGlossary">
                    <i class="fa fa-book me-1" role="img" aria-label="Glossary"/>Glossary
                </button>
            </div>
            <div class="ns_pause_cols">
                <div class="ns_pause_col">
                    <span class="ns_pause_label">CONTROLS</span>
                    <p class="ns_hint mb-0">
                        Drag to move · <b>Space</b> dashes (you are untouchable during it) · <b>X</b> spends a bomb · <b>1-4</b> fire your active perks.
                        Hold <b>Shift</b> to focus: you fly slower and your hitbox is drawn — it is much smaller than the ship.
                        Skimming past a bullet without being hit builds your combo; clearing a wave untouched pays a bonus.
                        Every 5 waves you keep 1 of 3 permanent upgrades; a colossal boss shows up every 10.
                        Capsules: T triple · S shield · B bomb · + life.
                        <t t-if="multiplayer">Fly next to a downed ally to revive them.</t>
                    </p>
                    <t t-if="state.perks.length">
                        <span class="ns_pause_label">PERKS YOU KEEP</span>
                        <ul class="ns_pause_perks list-unstyled mb-0">
                            <li t-foreach="state.perks" t-as="p" t-key="p_index"
                                t-attf-style="--ns-perk: {{ p.tint }}">
                                <span t-out="p.name"/>
                                <span class="ns_pause_key" t-if="p.key">key <t t-out="p.key"/></span>
                            </li>
                        </ul>
                    </t>
                </div>
                <div class="ns_pause_col ns_pause_board">
                    <span class="ns_pause_label">LEADERBOARD</span>
                    <!-- This column owns its own scroll inside a panel that is
                         capped at the viewport: a full board must not push the
                         overlay past `.o_neon_strike_root`, which clips. -->
                    <div class="ns_pause_scroll">
                        <t t-call="neon_strike.Leaderboard"/>
                    </div>
                </div>
            </div>
            <div class="ns_pause_foot d-flex align-items-center px-3 py-2">
                <span class="ns_pause_hint">Tips show up in the field, next to the thing they explain.</span>
                <a href="https://www.odoo.com/page/brand-assets" target="_blank" rel="noreferrer"
                   class="ns_brand_link ms-auto">built on Odoo</a>
            </div>
        </div>
    </div>
</t>

<!-- Feedback panel: overlays any screen, so a bug can be reported mid-run. -->
<t t-name="neon_strike.Feedback">
    <div class="ns_glossary ns_feedback" role="dialog" aria-label="Send feedback"
         t-on-click="onFeedbackBackdrop">
        <div class="ns_glossary_panel ns_feedback_panel">
            <div class="ns_glossary_head d-flex align-items-center">
                <h4 class="ns_glossary_title mb-0">REPORT A BUG OR AN IDEA</h4>
                <button class="btn btn-sm ns_btn ms-auto" t-on-click="closeFeedback">
                    <i class="fa fa-times me-1" role="img" aria-label="Close"/>Close
                </button>
            </div>
            <div class="ns_glossary_body">
                <t t-if="state.fb.sent">
                    <div class="ns_fb_sent">
                        <i class="fa fa-check-circle me-2" role="img" aria-label="Sent"/>
                        Thanks! It landed in the team's inbox.
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn ns_cta" t-on-click="closeFeedback">Back to the game</button>
                        <button class="btn ns_btn" t-on-click="openFeedback">Send another</button>
                    </div>
                </t>
                <t t-else="">
                    <div class="ns_fb_kinds mb-3">
                        <button t-foreach="[['bug','fa-bug','Bug'],['idea','fa-lightbulb-o','Idea'],['other','fa-comment-o','Other']]"
                                t-as="opt" t-key="opt[0]"
                                t-attf-class="btn ns_btn ns_fb_kind {{ state.fb.kind === opt[0] ? 'active' : '' }}"
                                t-on-click="() => this.setFeedbackKind(opt[0])">
                            <i t-attf-class="fa {{ opt[1] }} me-1" role="img" aria-hidden="true"/>
                            <t t-out="opt[2]"/>
                        </button>
                    </div>
                    <label class="ns_nick_label" for="ns_fb_message">
                        What happened, or what would you add?
                    </label>
                    <textarea id="ns_fb_message" class="form-control ns_fb_text" rows="6"
                              maxlength="4000"
                              placeholder="The more precise, the better: what you were doing, what you expected, what happened instead."
                              t-model="state.fb.message"/>
                    <div class="ns_fb_tools d-flex flex-wrap align-items-center gap-2 mt-3">
                        <label class="btn ns_btn mb-0">
                            <i class="fa fa-picture-o me-1" role="img" aria-label="Image"/>Attach an image
                            <input type="file" accept="image/png,image/jpeg,image/gif,image/webp"
                                   class="d-none" t-on-change="onFeedbackFile"/>
                        </label>
                        <button t-if="canScreenshot" class="btn ns_btn" t-on-click="attachScreenshot">
                            <i class="fa fa-camera me-1" role="img" aria-label="Screenshot"/>Use the current screen
                        </button>
                        <span class="ns_fb_hint">PNG, JPEG, GIF or WebP · shrunk before sending</span>
                    </div>
                    <div t-if="state.fb.image" class="ns_fb_preview mt-3">
                        <img t-att-src="state.fb.image" alt="Attached screenshot"/>
                        <button class="btn btn-sm ns_btn" t-on-click="clearFeedbackImage">
                            <i class="fa fa-trash me-1" role="img" aria-label="Remove"/>Remove
                        </button>
                    </div>
                    <p t-if="state.fb.error" class="ns_error mt-3 mb-0" t-out="state.fb.error"/>
                    <div class="d-flex align-items-center gap-3 mt-3">
                        <button class="btn ns_cta" t-on-click="sendFeedback"
                                t-att-disabled="state.fb.sending">
                            <i class="fa fa-paper-plane me-2" role="img" aria-label="Send"/>
                            <t t-out="state.fb.sending ? 'Sending…' : 'Send'"/>
                        </button>
                        <span class="ns_fb_hint">
                            Sent with your nickname and the wave you are on.
                        </span>
                    </div>
                </t>
            </div>
        </div>
    </div>
</t>

<!-- Glossary panel: overlays the menu, with the animated backdrop behind. -->
<t t-name="neon_strike.Glossary">
    <div class="ns_glossary" role="dialog" aria-label="Glossary of ships and enemies"
         t-on-click="onGlossaryBackdrop">
        <div class="ns_glossary_panel">
            <div class="ns_glossary_head d-flex align-items-center">
                <h4 class="ns_glossary_title mb-0">
                    <t t-if="state.picker">PRACTICE · PICK A TARGET</t>
                    <t t-else="">SHIPS, ENEMIES AND POWERS</t>
                </h4>
                <button class="btn btn-sm ns_btn ms-auto" t-on-click="toggleGlossary">
                    <i class="fa fa-times me-1" role="img" aria-label="Close"/>Close
                </button>
            </div>
            <div class="ns_glossary_body" t-ref="glossaryBody">
                <div t-if="state.picker" class="ns_practice_note">
                    Practice mode: pick an enemy, a boss or a colossus and the run
                    spawns nothing else, wave after wave. Pick a place instead and
                    the run is the normal game with the sky pinned to it, which is
                    the only way to see a backdrop with a real wave in front of it.
                    Nothing is saved to the leaderboard.
                </div>
                <div class="ns_controls">
                    <span class="ns_key">Drag</span> move ·
                    <span class="ns_key">Space</span> dash ·
                    <span class="ns_key">Shift</span> focus (slow, shows your hitbox) ·
                    <span class="ns_key">X</span> bomb ·
                    <span class="ns_key">1</span><span class="ns_key">2</span><span class="ns_key">3</span><span class="ns_key">4</span> active perks ·
                    every 5 waves you keep 1 of 3 upgrades until you die.
                </div>
                <t t-foreach="glossaryGroups" t-as="group" t-key="group.title">
                    <div class="ns_glossary_group">
                        <div class="ns_glossary_group_head" t-out="group.title"/>
                        <p t-if="group.note" class="ns_glossary_note" t-out="group.note"/>
                        <div class="ns_glossary_grid">
                            <div t-foreach="group.items" t-as="item" t-key="item.label" class="ns_glossary_card">
                                <!-- Places are wide painted stills, not pixel art: their
                                     frame fills the card and is not rendered pixelated.
                                     An enemy with a `kit` gets a live canvas its own
                                     animator paints, so the card runs. -->
                                <div class="ns_glossary_art" t-att-class="{ ns_glossary_art_wide: item.bg }">
                                    <canvas t-if="item.kit" class="ns_glossary_anim"
                                            t-att-data-kit="item.kit" t-att-data-sprite="item.sprite"
                                            t-att-data-tint="item.tint" t-att-data-px="item.px"
                                            role="img" t-att-aria-label="item.label"/>
                                    <img t-else="" t-att-src="item.src" t-att-alt="item.label"/>
                                </div>
                                <div class="ns_glossary_label" t-out="item.label"/>
                                <div class="ns_glossary_sub" t-out="item.sub"/>
                                <p class="ns_glossary_desc" t-out="item.desc"/>
                                <button t-if="state.picker and item.practice"
                                        class="btn btn-sm ns_btn ns_practice_btn w-100"
                                        t-on-click="() => this.startPractice(item)">
                                    <i class="fa me-1" t-att-class="item.practiceIcon or 'fa-crosshairs'"
                                       role="img" aria-label="Practice"/>
                                    <t t-out="item.practiceCta or 'Practice'"/>
                                </button>
                            </div>
                        </div>
                    </div>
                </t>
                <!-- The 50 permanent perks: no sprite, tinted text cards. -->
                <t t-foreach="perkGroups" t-as="group" t-key="group.title">
                    <div class="ns_glossary_group">
                        <div class="ns_glossary_group_head">
                            <t t-out="group.title"/> · <t t-out="group.items.length"/>
                        </div>
                        <p class="ns_glossary_note" t-out="group.note"/>
                        <div class="ns_perk_grid">
                            <div t-foreach="group.items" t-as="perk" t-key="perk.id"
                                 class="ns_perk_card" t-attf-style="border-left-color: {{ perk.tint }}">
                                <div class="ns_perk_name" t-attf-style="color: {{ perk.tint }}" t-out="perk.name"/>
                                <div class="ns_perk_tag">
                                    <t t-out="perk.tag"/>
                                    <t t-if="perk.cdLabel"> · <t t-out="perk.cdLabel"/></t>
                                    <t t-if="perk.coop"> · co-op only</t>
                                </div>
                                <p class="ns_perk_desc" t-out="perk.desc"/>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </div>
</t>

<t t-name="neon_strike.Leaderboard">
    <h5 class="mb-3">
        <i class="fa fa-trophy me-2" role="img" aria-label="Trophy"/>Leaderboard
    </h5>
    <table class="table table-sm ns_table">
        <thead>
            <tr>
                <th>#</th>
                <th>Player</th>
                <th class="text-end">Points</th>
                <th class="text-end">Wave</th>
                <th class="text-end">Time</th>
            </tr>
        </thead>
        <tbody>
            <t t-foreach="topScores" t-as="s" t-key="s.id">
                <tr>
                    <td t-out="s_index + 1"/>
                    <td>
                        <span t-out="s.player_name"/>
                        <span class="ns_coop_tag ms-1" t-if="s.mode === 'coop'" t-attf-title="Co-op · {{ s.player_count }} players">co-op x<t t-out="s.player_count"/></span>
                    </td>
                    <td class="text-end" t-out="fmt(s.score)"/>
                    <td class="text-end" t-out="s.wave"/>
                    <td class="text-end ns_time" t-out="fmtTime(s.duration)"/>
                </tr>
            </t>
            <tr t-if="!topScores.length">
                <td colspan="5" class="text-muted">No scores yet. Be the first!</td>
            </tr>
        </tbody>
    </table>
</t>

</templates>
