<odoo>

    <!-- Public page serving the OWL game without requiring a login. It relies on
         `web.frontend_layout` to load the frontend assets and the session info
         the canonical way. Careful: with `website` installed that layout
         inherits `website.layout`, which requires `website` in the context, so
         the route must declare `website=True` (see controllers/main.py). The
         component is mounted on `.o_neon_strike_root` (see the bootstrap in
         neon_strike_game.js), positioned full screen by CSS. -->
    <template id="page" name="Neon Strike">
        <t t-call="web.frontend_layout">
            <t t-set="title">Neon Strike</t>
            <!-- The game fills the whole window: no header/footer (not even
                 the website module ones, if installed). -->
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="additional_head">
                <meta name="generator" content="Odoo"/>
                <meta name="author" content="Odoo"/>
            </t>
            <div class="o_neon_strike_root"/>
        </t>
    </template>

</odoo>
