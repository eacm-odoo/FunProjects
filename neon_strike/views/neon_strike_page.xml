<odoo>

    <!-- Página pública que sirve el juego OWL sin necesidad de login. Se apoya
         en `web.frontend_layout` para cargar los assets frontend y la session
         info de forma canónica. Ojo: con `website` instalado, ese layout hereda
         `website.layout`, que exige `website` en el contexto, así que la ruta
         debe declarar `website=True` (ver controllers/main.py). El
         componente se monta en `.o_neon_strike_root` (ver el bootstrap en
         neon_strike_game.js), que se posiciona a pantalla completa por CSS. -->
    <template id="page" name="Neon Strike">
        <t t-call="web.frontend_layout">
            <t t-set="title">Neon Strike</t>
            <!-- El juego ocupa toda la ventana: nada de header/footer (ni los
                 del módulo website, si está instalado). -->
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="additional_head">
                <meta name="generator" content="Odoo"/>
                <meta name="author" content="Odoo"/>
            </t>
            <div class="o_neon_strike_root"/>
        </t>
    </template>

</odoo>
