<odoo>

    <record id="neon_strike_feedback_view_list" model="ir.ui.view">
        <field name="name">neon.strike.feedback.view.list</field>
        <field name="model">neon.strike.feedback</field>
        <field name="arch" type="xml">
            <list create="false" decoration-muted="state in ('done', 'wont')"
                  decoration-bf="state == 'new'">
                <field name="create_date" string="Received"/>
                <field name="kind"/>
                <field name="title"/>
                <field name="nickname"/>
                <field name="mode"/>
                <field name="wave"/>
                <field name="image" widget="image" width="60" options="{'size': [40, 40]}"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-warning="state == 'open'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="neon_strike_feedback_view_form" model="ir.ui.view">
        <field name="name">neon.strike.feedback.view.form</field>
        <field name="model">neon.strike.feedback</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="float-end"
                           options="{'size': [260, 260]}"/>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title" readonly="1"/></h1>
                        <field name="kind" widget="radio" options="{'horizontal': true}"/>
                    </div>
                    <group>
                        <group string="Player">
                            <field name="nickname" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="token" readonly="1" groups="base.group_no_one"/>
                            <field name="create_date" string="Received" readonly="1"/>
                        </group>
                        <group string="Run">
                            <field name="mode" readonly="1"/>
                            <field name="wave" readonly="1"/>
                            <field name="score" readonly="1"/>
                            <field name="perks" readonly="1"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Internal Note">
                        <field name="note" nolabel="1" placeholder="What you decided, what you changed…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="neon_strike_feedback_view_search" model="ir.ui.view">
        <field name="name">neon.strike.feedback.view.search</field>
        <field name="model">neon.strike.feedback</field>
        <field name="arch" type="xml">
            <search>
                <field name="message"/>
                <field name="nickname"/>
                <filter name="filter_new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="filter_open" string="In Progress" domain="[('state', '=', 'open')]"/>
                <separator/>
                <filter name="filter_bug" string="Bugs" domain="[('kind', '=', 'bug')]"/>
                <filter name="filter_idea" string="Ideas" domain="[('kind', '=', 'idea')]"/>
                <separator/>
                <filter name="filter_image" string="With Screenshot" domain="[('image', '!=', False)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_kind" string="Type" context="{'group_by': 'kind'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_neon_strike_feedback" model="ir.actions.act_window">
        <field name="name">Feedback</field>
        <field name="res_model">neon.strike.feedback</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No feedback yet
            </p>
            <p>
                Bug reports and ideas players send from the game page land here,
                with the wave they were on and a screenshot when they attached one.
            </p>
        </field>
    </record>

    <menuitem id="menu_neon_strike_feedback"
              name="Feedback"
              parent="menu_neon_strike_root"
              action="action_neon_strike_feedback"
              sequence="40"/>

</odoo>
