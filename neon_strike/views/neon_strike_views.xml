<?xml version="1.0" encoding="utf-8"?>
<!-- Part of Odoo. See LICENSE file for full copyright and licensing details. -->
<odoo>

    <record id="neon_strike_score_view_list" model="ir.ui.view">
        <field name="name">neon.strike.score.view.list</field>
        <field name="model">neon.strike.score</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="player_name"/>
                <field name="score"/>
                <field name="wave"/>
                <field name="mode"/>
                <field name="player_count" string="Jugadores"/>
                <field name="create_date" string="Fecha"/>
            </list>
        </field>
    </record>

    <record id="action_neon_strike_scores" model="ir.actions.act_window">
        <field name="name">Marcadores</field>
        <field name="res_model">neon.strike.score</field>
        <field name="view_mode">list</field>
    </record>

    <!-- El juego vive en la página pública /neon; este acceso la abre en una pestaña. -->
    <record id="action_neon_strike_play_url" model="ir.actions.act_url">
        <field name="name">Jugar</field>
        <field name="url">/neon</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_neon_strike_root"
              name="Neon Strike"
              web_icon="neon_strike,static/description/icon.png"
              sequence="90"/>
    <menuitem id="menu_neon_strike_game"
              name="Jugar"
              parent="menu_neon_strike_root"
              action="action_neon_strike_play_url"
              sequence="10"/>
    <menuitem id="menu_neon_strike_scores"
              name="Marcadores"
              parent="menu_neon_strike_root"
              action="action_neon_strike_scores"
              sequence="20"/>

</odoo>
