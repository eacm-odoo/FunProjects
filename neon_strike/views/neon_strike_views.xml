<odoo>

    <record id="neon_strike_score_view_list" model="ir.ui.view">
        <field name="name">neon.strike.score.view.list</field>
        <field name="model">neon.strike.score</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="player_name"/>
                <field name="score"/>
                <field name="wave"/>
                <field name="mode"/>
                <field name="player_count" string="Players"/>
                <!-- Lives lost: the same score with two deaths and with twenty
                     are not the same run, and nothing else in the row says so. -->
                <field name="deaths" optional="show"/>
                <!-- The footer sums are the internal stat: how long the run
                     lasted and, multiplied by the players, how much human time
                     it added up to. -->
                <field name="duration" widget="float_time" sum="Total duration"/>
                <field name="play_time" widget="float_time" sum="Total time played"/>
                <field name="create_date" string="Date"/>
            </list>
        </field>
    </record>

    <record id="neon_strike_score_view_search" model="ir.ui.view">
        <field name="name">neon.strike.score.view.search</field>
        <field name="model">neon.strike.score</field>
        <field name="arch" type="xml">
            <search>
                <field name="player_name"/>
                <field name="nickname"/>
                <filter name="filter_solo" string="Solo" domain="[('mode', '=', 'solo')]"/>
                <filter name="filter_coop" string="Co-op" domain="[('mode', '=', 'coop')]"/>
                <separator/>
                <filter name="filter_today" string="Today" domain="[('create_date', '&gt;=', 'today')]"/>
                <!-- Odoo 19: the group-by block is a bare <group>; `string`
                     and `expand` are not valid attributes any more. -->
                <group>
                    <filter name="group_mode" string="Mode" context="{'group_by': 'mode'}"/>
                    <filter name="group_players" string="Players" context="{'group_by': 'player_count'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Internal statistic: total time played, sliceable by mode and date. -->
    <record id="neon_strike_score_view_pivot" model="ir.ui.view">
        <field name="name">neon.strike.score.view.pivot</field>
        <field name="model">neon.strike.score</field>
        <field name="arch" type="xml">
            <pivot string="Time played" sample="1">
                <field name="create_date" interval="day" type="row"/>
                <field name="mode" type="col"/>
                <field name="play_time" type="measure" widget="float_time"/>
                <field name="duration" type="measure" widget="float_time"/>
            </pivot>
        </field>
    </record>

    <record id="action_neon_strike_scores" model="ir.actions.act_window">
        <field name="name">Leaderboard</field>
        <field name="res_model">neon.strike.score</field>
        <field name="view_mode">list,pivot</field>
    </record>

    <!-- Same records, opened straight on the pivot: the play-time statistic. -->
    <record id="action_neon_strike_playtime" model="ir.actions.act_window">
        <field name="name">Time Played</field>
        <field name="res_model">neon.strike.score</field>
        <field name="view_mode">pivot,list</field>
        <field name="context">{'search_default_group_date': 1}</field>
    </record>

    <!-- The game lives on the public /neon page; this action opens it in a tab. -->
    <record id="action_neon_strike_play_url" model="ir.actions.act_url">
        <field name="name">Play</field>
        <field name="url">/neon</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_neon_strike_root"
              name="Neon Strike"
              web_icon="neon_strike,static/description/icon.png"
              sequence="90"/>
    <menuitem id="menu_neon_strike_game"
              name="Play"
              parent="menu_neon_strike_root"
              action="action_neon_strike_play_url"
              sequence="10"/>
    <menuitem id="menu_neon_strike_scores"
              name="Leaderboard"
              parent="menu_neon_strike_root"
              action="action_neon_strike_scores"
              sequence="20"/>
    <menuitem id="menu_neon_strike_playtime"
              name="Time Played"
              parent="menu_neon_strike_root"
              action="action_neon_strike_playtime"
              sequence="30"/>

</odoo>
